{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karv-cloud-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "preview_urls": false,
  "workers_dev": false,
  "analytics_engine_datasets": [
    {
      "binding": "KARV_ANALYTICS",
      "dataset": "karv_platform_metrics"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "AI_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1000",
        "simple": {
          "limit": 30,
          "period": 60
        }
      }
    ]
  },
  "triggers": {
    "crons": ["0 12 * * MON", "0 12 1 * *"]
  },
  "vars": {
    "AI_API_ENABLED": "false",
    "AI_GATEWAY_BASE_URL": "",
    "ALLOWED_ORIGINS": "",
    "KARV_DEFAULT_PROJECT": "karv-lps",
    "KARV_PROJECTS": "karv-lps,KV_COLLAB_BLING,3D,karv-cloud-platform",
    "KARV_PROJECT_POLICIES": "{\"karv-lps\":{\"tasks\":[\"catalog_summary\",\"order_summary\",\"seo_draft\"],\"maxInputChars\":8000},\"KV_COLLAB_BLING\":{\"tasks\":[\"order_summary\"],\"maxInputChars\":6000},\"3D\":{\"tasks\":[\"catalog_summary\"],\"maxInputChars\":4000},\"karv-cloud-platform\":{\"tasks\":[\"catalog_summary\"],\"maxInputChars\":4000}}",
    "OPENAI_MODEL": "gpt-5.6-terra",
    "ANTHROPIC_MODEL": "claude-sonnet-4-5",
    "REPORT_DELIVERY_ENABLED": "false",
    "REPORTING_API_ENABLED": "false"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "staging": {
      "name": "karv-cloud-platform-staging",
      "preview_urls": false,
      "workers_dev": true,
      "analytics_engine_datasets": [
        {
          "binding": "KARV_ANALYTICS",
          "dataset": "karv_platform_metrics_staging"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "AI_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1001",
            "simple": {
              "limit": 10,
              "period": 60
            }
          }
        ]
      },
      "triggers": {
        "crons": []
      },
      "vars": {
        "AI_API_ENABLED": "false",
        "AI_GATEWAY_BASE_URL": "https://gateway.ai.cloudflare.com/v1/d229397cfd525e985402adc042591d02/karv-ai-gateway-staging",
        "ALLOWED_ORIGINS": "",
        "KARV_DEFAULT_PROJECT": "karv-lps",
        "KARV_PROJECTS": "karv-lps,KV_COLLAB_BLING,3D,karv-cloud-platform",
        "KARV_PROJECT_POLICIES": "{\"karv-lps\":{\"tasks\":[\"catalog_summary\",\"order_summary\",\"seo_draft\"],\"maxInputChars\":8000},\"KV_COLLAB_BLING\":{\"tasks\":[\"order_summary\"],\"maxInputChars\":6000},\"3D\":{\"tasks\":[\"catalog_summary\"],\"maxInputChars\":4000},\"karv-cloud-platform\":{\"tasks\":[\"catalog_summary\"],\"maxInputChars\":4000}}",
        "OPENAI_MODEL": "gpt-5.6-terra",
        "ANTHROPIC_MODEL": "claude-sonnet-4-5",
        "REPORT_DELIVERY_ENABLED": "false",
        "REPORTING_API_ENABLED": "false"
      }
    },
    "production": {
      "name": "karv-cloud-platform",
      "preview_urls": false,
      "workers_dev": false,
      "analytics_engine_datasets": [
        {
          "binding": "KARV_ANALYTICS",
          "dataset": "karv_platform_metrics"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "AI_RATE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1002",
            "simple": {
              "limit": 10,
              "period": 60
            }
          }
        ]
      },
      "triggers": {
        "crons": ["0 12 * * MON", "0 12 1 * *"]
      },
      "vars": {
        "AI_API_ENABLED": "false",
        "AI_GATEWAY_BASE_URL": "",
        "ALLOWED_ORIGINS": "",
        "KARV_DEFAULT_PROJECT": "karv-lps",
        "KARV_PROJECTS": "karv-lps,KV_COLLAB_BLING,3D,karv-cloud-platform",
        "KARV_PROJECT_POLICIES": "{\"karv-lps\":{\"tasks\":[\"catalog_summary\",\"order_summary\",\"seo_draft\"],\"maxInputChars\":8000},\"KV_COLLAB_BLING\":{\"tasks\":[\"order_summary\"],\"maxInputChars\":6000},\"3D\":{\"tasks\":[\"catalog_summary\"],\"maxInputChars\":4000},\"karv-cloud-platform\":{\"tasks\":[\"catalog_summary\"],\"maxInputChars\":4000}}",
        "OPENAI_MODEL": "gpt-5.6-terra",
        "ANTHROPIC_MODEL": "claude-sonnet-4-5",
        "REPORT_DELIVERY_ENABLED": "false",
        "REPORTING_API_ENABLED": "false"
      }
    }
  }
}
